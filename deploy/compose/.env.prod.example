# Postgres
POSTGRES_DB=texsa
POSTGRES_USER=texsa
POSTGRES_PASSWORD=change-me-postgres

# Redis
REDIS_PASSWORD=change-me-redis

# API
API_PORT=4000
JWT_ACCESS_SECRET=change-me-jwt-secret-min-32-chars
CORS_ORIGIN=http://192.168.1.50:3000

# Web (build-time arg baked into Next bundle — use LAN URL, not localhost)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://192.168.1.50:4000

# ICE / TURN (opcional; necessário para chamadas fora da LAN)
ICE_STUN_URLS=stun:stun.l.google.com:19302
ICE_TURN_URLS=
ICE_TURN_REST_SECRET=
ICE_TURN_USERNAME=
ICE_TURN_CREDENTIAL=
ICE_TURN_CREDENTIAL_TTL_SEC=3600